# Copy to .env and adjust. .env is gitignored.

# Postgres — matches docker-compose.yml
# connection_limit is not optional on a single box. Without it Prisma sizes
# its pool at cores*2+1 *per process*, and this deployment runs several: the
# app, the nightly chain, whatever an operator is running by hand. On a
# 16-core machine that is ~33 connections each against Postgres's default
# max_connections of 100 — reached in this session, where the symptom was
# "sorry, too many clients already" surfacing as tests silently skipping and
# psql itself refusing to connect.
DATABASE_URL="postgresql://grant:grant@localhost:5432/grant_assistant?schema=public&connection_limit=5"

# Ollama runtime (DECISIONS.md D1). No hosted model API key is used anywhere.
OLLAMA_HOST="http://localhost:11434"

# Working default. qwen3:4b fits a 4GB card with room for a real context window
# and handles Ukrainian materially better than the Llama 3 8B generation.
#   ollama pull qwen3:4b
GRANT_AI_MODEL="qwen3:4b"

# Ollama truncates from the START of an over-long prompt and reports nothing,
# which silently removes the system prompt. Size this against real fixtures.
GRANT_AI_NUM_CTX="16384"

# Fixed so an eval score movement can be attributed to the thing that changed.
GRANT_AI_SEED="7"

# --- Email digest (optional) ---
# Without all five of these the digest is written to .mail/ instead of being
# sent. A half-configured install that silently mails real NGOs is worse than
# one that visibly mails nobody.
#
# The relay (Brevo, SES, …) must have the MAIL_FROM *domain* authenticated —
# DKIM records in DNS. Verifying a single sender address does not work here:
# the relay mails a confirmation to that address and grantoid.in.ua has no
# mailbox (no MX, on purpose). `scripts/send-test-mail.ts` proves the path.
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="xxxxxx@smtp-brevo.com"
# SMTP_PASSWORD="xsmtpsib-..."          # an SMTP key, not the account password
# MAIL_FROM="грантоЇД.АІ <digest@grantoid.in.ua>"

# Which account the development scripts act as (smoke, dump-page, build-feed,
# seed:demo). Defaults to a reserved domain so nothing here names a real
# mailbox and so purge-test-data can recognise it. Set this to whatever
# `npm run seed:demo` created on your machine.
DEV_ORG_EMAIL="demo@example.org"

# Used in digest links. Must be the address people actually open.
APP_BASE_URL="http://localhost:3000"
