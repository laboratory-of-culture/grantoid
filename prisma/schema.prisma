// The grant record (brief §10) and the organization profile (§6–§7), plus the
// minimum around them to make both useful — sources, provenance, and the match
// rows that consume them.
//
// Signed off 2026-08-10. Decisions behind it: docs/DECISIONS.md D2 and D4.
//
// The whole schema turns on one decision, in `OrganizationFact`: "we have not
// asked this organization yet" is a *stored state*, not a NULL. A nullable
// column cannot tell "no international partners" apart from "never asked about
// international partners", and collapsing those two is precisely the failure
// the product exists to prevent. Everything else follows from that.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// The confidence ladder. Ordered — the overall verdict is the floor of the
/// mandatory criteria, never an average.
enum Verdict {
  MATCH
  LIKELY_MATCH
  UNCERTAIN
  LIKELY_NOT_ELIGIBLE
  NOT_ELIGIBLE
}

/// Why a criterion came out UNCERTAIN. This is what lets the UI split the
/// "unknown" bucket from the "potential problem" bucket without adding a sixth
/// verdict — see docs/proposals/milestone-1.md, open question 2.
enum UncertaintyReason {
  NO_PROFILE_DATA // the organization has not answered; action = complete profile
  AMBIGUOUS_CALL // the donor text does not settle it; action = read guidelines
  CONFLICTING_EVIDENCE // profile contradicts itself; action = human review
}

enum RuleKind {
  MANDATORY // gates eligibility
  PREFERRED // moves the score only
  EXCLUDED // describes who or what is ruled out
}

/// The state of one profile field. UNKNOWN is the default for every key in the
/// registry, so silence is always representable.
enum FactState {
  UNKNOWN // never asked, or asked and skipped
  SELF_REPORTED // the org said it; not yet verified against a document
  CONFIRMED // backed by a document citation and confirmed by a human
  EXPLICIT_NEGATIVE // the org confirmed it does NOT have or do this
}

enum LegalForm {
  GROMADSKA_ORGANIZATSIYA // ГО
  BLAHODIYNA_ORGANIZATSIYA // БО
  GROMADSKA_SPILKA
  KOMUNALNYI_ZAKLAD
  RELIHIYNA_ORGANIZATSIYA
  INSHE
}

enum GrantStatus {
  OPEN
  CLOSED
  UPCOMING
  UNKNOWN
}

enum SourceKind {
  DONOR
  AGGREGATOR
  PORTAL
  NEWSLETTER
}

enum DocumentKind {
  STATUT
  REGISTRATION
  ANNUAL_REPORT
  PREVIOUS_APPLICATION
  PROJECT_DESCRIPTION
  STRATEGY
  CALL_GUIDELINES
  OTHER
}

// ---------------------------------------------------------------------------
// Provenance
// ---------------------------------------------------------------------------

/// A verbatim quote and where it came from. `quote` is required: a citation
/// that cannot show its words is not a citation.
///
/// Polymorphic via nullable parent FKs — Prisma has no native polymorphism, and
/// a join table per parent buys nothing here.
model Citation {
  id          String   @id @default(cuid())
  quote       String   @db.Text
  url         String?
  page        Int?
  retrievedAt DateTime

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  grantFactId String?
  grantFact   GrantFact? @relation(fields: [grantFactId], references: [id], onDelete: Cascade)

  organizationFactId String?
  organizationFact   OrganizationFact? @relation(fields: [organizationFactId], references: [id], onDelete: Cascade)

  eligibilityRuleId String?
  eligibilityRule   GrantEligibilityRule? @relation(fields: [eligibilityRuleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([grantFactId])
  @@index([organizationFactId])
  @@index([eligibilityRuleId])
}

// ---------------------------------------------------------------------------
// Sources and grants
// ---------------------------------------------------------------------------

/// A donor site or aggregator we ingest from. The robots/ToS fields are columns
/// rather than notes because "did anyone check whether we're allowed to crawl
/// this" is the question most likely to be skipped under delivery pressure.
model Source {
  id          String     @id @default(cuid())
  name        String
  homepageUrl String
  kind        SourceKind
  enabled     Boolean    @default(false)

  /// How items are discovered. Separate from `kind`, which says what the source
  /// *is* — the two are independent, and assuming an aggregator publishes a feed
  /// is how you find out at implementation time that it does not.
  discovery   Discovery  @default(RSS)
  /// The feed for RSS, or the listing page for HTML_LIST.
  discoveryUrl String?
  /// Sent on every request. A crawler that does not say who it is and how to
  /// complain is one a small NGO portal is right to block.
  userAgent   String?

  robotsCheckedAt DateTime?
  robotsAllows    Boolean?
  tosReviewedAt   DateTime?
  tosNote         String?   @db.Text
  contactEmail    String?

  crawlCadenceHours Int       @default(24)
  rateLimitPerMin   Int       @default(10)
  lastCrawledAt     DateTime?
  lastError         String?   @db.Text

  grants    Grant[]
  items     SourceItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([homepageUrl])
}

enum Discovery {
  RSS
  HTML_LIST
}

/// One thing a source announced, before anyone decided what it is.
///
/// Discovery and extraction are separate stages because the sources do not
/// publish grants — they publish *opportunities*. The Громадський Простір feed
/// carries procurement tenders, equipment purchases and training schools
/// alongside actual grant calls, all under one post type. Something has to read
/// each item and decide, and that decision is where §40's precision is won or
/// lost — so it gets its own row, its own status, and its own audit trail
/// rather than being an implicit filter inside a crawler.
model SourceItem {
  id       String @id @default(cuid())
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  /// Stable id within the source: the RSS guid, or the listing path.
  externalId String
  url        String
  title      String
  summary    String?  @db.Text
  publishedAt DateTime?

  status ItemStatus @default(NEW)
  /// Why it was rejected, in the classifier's words. Read before trusting a
  /// low grant count.
  statusNote String? @db.Text

  /// Set once the item has been turned into a Grant.
  grantId String?

  /// Detects a re-announcement of the same item with an edited title.
  contentHash  String
  discoveredAt DateTime @default(now())
  checkedAt    DateTime @default(now())

  @@unique([sourceId, externalId])
  @@index([sourceId, status])
  @@index([status, discoveredAt])
}

enum ItemStatus {
  NEW
  /// Classified as a fundable call an NGO could apply to.
  GRANT
  /// Classified as something else — a tender, a purchase, a course.
  NOT_GRANT
  /// Turned into a Grant record.
  EXTRACTED
  FAILED
}

/// A normalized funding opportunity.
///
/// Scalar columns exist for the fields the feed filters and sorts on. Anything
/// the UI *asserts* to a user is also a `GrantFact` carrying a citation — the
/// column is the index, the fact is the evidence.
///
/// NULL on `deadline`, `cofinancingRequired` or `maxSharePct` means UNREAD, not
/// absent. `extractionNotes` records what was not read.
model Grant {
  id       String  @id @default(cuid())
  /// Null for a call an organization supplied itself — see `ownerOrganizationId`.
  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id])

  /// Set when this call belongs to one organization rather than to everybody.
  ///
  /// Donors mail PDFs. A call that arrived in one NGO's inbox was never
  /// published on ГУРТ or Простір, and putting it in the shared `Grant` table
  /// unscoped would show every other organization a competition they were not
  /// invited to — and tell them who else is applying. So the row is owned, and
  /// every read that builds a feed filters on `ownerOrganizationId IS NULL OR
  /// = :organization`.
  ownerOrganizationId String?
  ownerOrganization   Organization? @relation("PrivateGrants", fields: [ownerOrganizationId], references: [id], onDelete: Cascade)

  /// Stable dedupe key within a source — usually the canonical URL path.
  externalKey String

  title          String
  titleUk        String?
  donorName      String
  sourceUrl      String
  applicationUrl String?

  status          GrantStatus @default(UNKNOWN)
  deadline        DateTime?
  deadlineIsKnown Boolean     @default(false)

  fundingMin          Decimal? @db.Decimal(14, 2)
  fundingMax          Decimal? @db.Decimal(14, 2)
  currency            String?
  cofinancingRequired Boolean?
  maxSharePct         Decimal? @db.Decimal(5, 2)

  applicantTypes      String[]
  applicantGeography  String[]
  sectors             String[]
  themes              String[]
  targetGroups        String[]
  applicationLanguage String?

  extractionConfidence Float   @default(0)
  extractionNotes      String? @db.Text

  /// Hand-authored test record. Nothing treats it differently; the flag exists
  /// so no reader mistakes a fixture for a live call.
  synthetic Boolean @default(false)

  contentHash   String
  firstSeenAt   DateTime  @default(now())
  retrievedAt   DateTime
  lastCheckedAt DateTime
  closedSeenAt  DateTime?

  rules     GrantEligibilityRule[]
  facts     GrantFact[]
  chunks    GrantChunk[]
  snapshots GrantSnapshot[]
  matches   Match[]
  concepts  ConceptDraft[]
  /// Donor material an organization uploaded against this call.
  documents Document[]

  @@unique([sourceId, externalKey])
  @@index([ownerOrganizationId])
  @@index([status, deadline])
  @@index([lastCheckedAt])
}

/// One requirement the applicant is judged against.
model GrantEligibilityRule {
  id      String @id @default(cuid())
  grantId String
  grant   Grant  @relation(fields: [grantId], references: [id], onDelete: Cascade)

  /// Stable slug, e.g. "international-partner". Referenced by eval fixtures and
  /// by criterion assessments, so it must survive re-extraction of the grant.
  key        String
  text       String   @db.Text
  textUk     String?  @db.Text
  kind       RuleKind
  orderIndex Int      @default(0)

  /// Which profile fact would settle this rule. Powers the "add international
  /// partner to your profile" action on the match breakdown.
  resolvingFactKey String?

  citations   Citation[]
  assessments CriterionAssessment[]

  @@unique([grantId, key])
}

/// An asserted fact about a grant, with its evidence. Used for anything shown
/// to a user as a claim about the call.
model GrantFact {
  id      String @id @default(cuid())
  grantId String
  grant   Grant  @relation(fields: [grantId], references: [id], onDelete: Cascade)

  key        String
  valueText  String? @db.Text
  valueJson  Json?
  confidence Float   @default(0)

  citations Citation[]

  @@unique([grantId, key])
}

/// Point-in-time capture used to detect moved deadlines, changed requirements
/// and closed calls (brief §29).
model GrantSnapshot {
  id      String @id @default(cuid())
  grantId String
  grant   Grant  @relation(fields: [grantId], references: [id], onDelete: Cascade)

  capturedAt    DateTime @default(now())
  contentHash   String
  changedFields String[]
  rawExtract    Json

  @@index([grantId, capturedAt])
}

model GrantChunk {
  id        String                      @id @default(cuid())
  grantId   String
  grant     Grant                       @relation(fields: [grantId], references: [id], onDelete: Cascade)
  ordinal   Int
  text      String                      @db.Text
  embedding Unsupported("vector(1024)")?

  @@unique([grantId, ordinal])
}

// ---------------------------------------------------------------------------
// Organizations
// ---------------------------------------------------------------------------

model Organization {
  id     String  @id @default(cuid())
  name   String
  nameEn String?

  /// ЄДРПОУ — 8 digits. Unique when present; validated in the Zod schema.
  edrpou String? @unique

  legalForm       LegalForm?
  nonProfitStatus Boolean?
  registeredAt    DateTime?
  oblast          String?
  city            String?
  websiteUrl      String?

  /// Share of registry keys whose fact is not UNKNOWN. Drives onboarding.
  profileCompleteness Float @default(0)

  facts       OrganizationFact[]
  documents   Document[]
  matches     Match[]
  candidates  FactCandidate[]
  memberships Membership[]
  concepts    ConceptDraft[]
  /// Calls this organization supplied itself, invisible to everyone else.
  privateGrants Grant[] @relation("PrivateGrants")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The state of one profile field for one organization.
///
/// A row exists for every key in the fact registry from the moment the
/// organization is created, defaulting to UNKNOWN. That is what makes
/// "we have not asked" queryable, and what lets the eligibility agent emit
/// UNCERTAIN/NO_PROFILE_DATA instead of inferring from an absent row.
///
/// `confirmedAt` gates use: an unconfirmed fact may inform a match, but may not
/// be written into an application (brief §6, human-in-the-loop skill).
model OrganizationFact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// From the fixed registry in packages/schemas — not free text.
  key   String
  state FactState @default(UNKNOWN)

  valueText  String? @db.Text
  valueJson  Json?
  confidence Float?

  citations Citation[]

  confirmedByUserId String?
  confirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, state])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Platform operator, not an organization role. Membership.role governs what
  /// someone may do inside their own NGO; this governs the source registry,
  /// which belongs to nobody's organization.
  isAdmin      Boolean  @default(false)
  /// scrypt, with the salt and parameters encoded in the string. Never a plain
  /// hash — see packages/auth/password.ts.
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime?

  /// Weekly digest of new opportunities.
  ///
  /// Opt-in, and off by default. An NGO that never asked for mail and receives
  /// it has been spammed by a tool it trusted with its statute.
  digestOptIn Boolean @default(false)
  /// Random, and the only credential the unsubscribe link carries. Unsubscribing
  /// must not require signing in — a person who wants mail to stop is not in the
  /// mood to remember a password, and a link that demands one is a link that
  /// gets reported as spam instead.
  unsubscribeToken String? @unique
  lastDigestAt     DateTime?

  memberships Membership[]
  sessions    Session[]
}

/// Which organizations a person belongs to.
///
/// A join table rather than a column on User because the brief's §37 already
/// anticipates fundraising consultants working across several organizations,
/// and retrofitting that after sessions carry a single organization id is the
/// kind of change that leaks one tenant into another.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum MemberRole {
  OWNER
  MEMBER
}

/// A signed-in session.
///
/// The cookie carries a random token; only its hash is stored, so a dump of
/// this table does not let anyone sign in as anybody.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Append-only record of who decided what.
///
/// The compliance backbone for a product whose failure mode is a confidently
/// wrong claim made in an organization's name. `modelTag` and
/// `promptFingerprint` on agent entries are what make "why did it say that in
/// March" answerable — without them the log records that something happened and
/// not what produced it.
///
/// Never log document contents or fact values: log the subject and the
/// transition (see the pii-and-donor-data skill).
model AuditEntry {
  id             String   @id @default(cuid())
  organizationId String
  at             DateTime @default(now())

  actorType ActorType
  /// User id, or the agent name. Null for a system action.
  actorId   String?

  action      String
  subjectType String
  subjectId   String

  /// State transition, not content. e.g. "PENDING" → "ACCEPTED".
  fromState String?
  toState   String?

  modelTag          String?
  promptFingerprint String?

  @@index([organizationId, at])
  @@index([subjectType, subjectId])
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

/// A fact an extraction proposed, waiting for a person to accept or reject it.
///
/// Extraction cannot write `OrganizationFact` directly: there is one row per
/// key, so a proposal would overwrite an answer the organization already gave.
/// Staging them here is also what makes the confirmation queue possible —
/// several documents can propose different values for the same key, and the
/// person deciding needs to see them side by side with their sources.
model FactCandidate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  key   String
  /// Never CONFIRMED — extraction proposes, a person confirms.
  state FactState

  valueText String @db.Text
  /// Verbatim from the document. Checked against the source before the row is
  /// written; a proposal that fails that check never gets here.
  quote      String  @db.Text
  page       Int?
  confidence Float

  status      CandidateStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?
  /// What the person actually accepted, when they corrected the value.
  acceptedValue String?       @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId, status])
  @@index([documentId])
}

enum CandidateStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kind       DocumentKind
  filename   String
  storageKey String
  mimeType   String
  sizeBytes  Int
  pageCount  Int?

  /// Detects a re-upload of the same file. Unique per organization rather than
  /// globally — two NGOs may legitimately hold the same donor guidelines PDF,
  /// and a global constraint would let one learn that the other has it.
  contentHash String

  uploadedAt      DateTime  @default(now())
  extractedAt     DateTime?
  extractionError String?   @db.Text

  /// Which call this document belongs to, when it is the donor's own material
  /// rather than the organization's.
  ///
  /// Nullable because most documents describe the organization and apply to
  /// every call it works on; guidelines describe one call and must not leak
  /// into the profile knowledge base, which is why the extractor branches on
  /// this rather than on `kind` alone.
  grantId String?
  grant   Grant?  @relation(fields: [grantId], references: [id], onDelete: SetNull)

  citations  Citation[]
  candidates FactCandidate[]

  @@unique([organizationId, contentHash])
  @@index([organizationId, kind])
  @@index([grantId])
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

/// One assessment of one organization against one grant.
///
/// The uniqueness key includes the prompt fingerprint and both content hashes:
/// a match is only reusable while the grant, the profile and the prompt are all
/// unchanged. Anything else is a stale verdict pretending to be current.
model Match {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantId        String
  grant          Grant        @relation(fields: [grantId], references: [id], onDelete: Cascade)

  overall    Verdict
  /// Fit on the merits, ignoring hard blockers. Never rendered without the
  /// criterion breakdown beside it.
  matchScore Int
  recommend  Boolean

  summary       String   @db.Text
  blockers      String[]
  openQuestions String[]

  modelTag           String
  promptFingerprint  String
  numCtx             Int?
  seed               Int?
  inputTokens        Int?
  outputTokens       Int?
  latencyMs          Int?
  grantContentHash   String
  profileVersionHash String

  assessments CriterionAssessment[]
  computedAt  DateTime              @default(now())

  @@unique([organizationId, grantId, promptFingerprint, grantContentHash, profileVersionHash])
  @@index([organizationId, recommend, overall])
}

/// The verdict on one rule, with both sides of the evidence.
///
/// `grantQuote` is required. `profileQuote` is null exactly when the profile
/// does not settle the rule — in which case the verdict is UNCERTAIN and
/// `uncertaintyReason` and `missingInformation` are populated. Enforced in the
/// Zod schema and by a check constraint added in the migration.
model CriterionAssessment {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ruleId  String
  rule    GrantEligibilityRule @relation(fields: [ruleId], references: [id])

  verdict           Verdict
  uncertaintyReason UncertaintyReason?
  rationale         String             @db.Text

  grantQuote         String  @db.Text
  profileQuote       String? @db.Text
  missingInformation String? @db.Text

  /// Copied from the rule at assessment time so the resolve action survives
  /// re-extraction of the grant.
  resolvingFactKey String?

  @@index([matchId])
}

// ---------------------------------------------------------------------------
// The grant editor
// ---------------------------------------------------------------------------

/// One concept note being written against one call.
///
/// Keyed on the pair, not on the grant alone: two organizations working on the
/// same call are writing two unrelated documents, and the tenancy layer scopes
/// this the same way it scopes a profile fact.
///
/// There is no `content` column. A concept is written and reviewed section by
/// section, and a single blob would lose which parts a person has actually read
/// — which is the distinction `human-in-the-loop` exists to keep.
model ConceptDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantId        String
  grant          Grant        @relation(fields: [grantId], references: [id], onDelete: Cascade)

  title  String
  status DraftStatus @default(DRAFT)

  /// The model and prompt that produced the current generation, so a draft can
  /// be told apart from one written under a different prompt.
  modelTag          String?
  promptFingerprint String?

  sections  ConceptSection[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([organizationId, grantId])
  @@index([organizationId, status])
}

enum DraftStatus {
  DRAFT
  /// Every section has been read by a person. Nothing may be exported before.
  REVIEWED
}

/// One section of a concept note.
///
/// `source` is the whole point of the row existing separately. An AI-written
/// section that nobody has touched must be labelled as such wherever it is
/// shown, and must not reach a donor — a person editing it is what changes
/// that, so the transition is recorded rather than inferred.
model ConceptSection {
  id      String       @id @default(cuid())
  draftId String
  draft   ConceptDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  /// Stable slug from the section registry in packages/schemas.
  key        String
  orderIndex Int    @default(0)

  content String @db.Text
  source  SectionSource @default(AI_DRAFT)

  /// Set when a person last changed the text. Null means nobody has.
  editedAt     DateTime?
  editedByUserId String?
  /// Set when a person marked the section as read and correct.
  approvedAt   DateTime?

  @@unique([draftId, key])
  @@index([draftId, orderIndex])
}

enum SectionSource {
  /// Written by a model, untouched. Labelled everywhere it appears.
  AI_DRAFT
  /// A model draft a person has since edited.
  HUMAN_EDITED
  /// Written by a person from scratch.
  HUMAN
}
