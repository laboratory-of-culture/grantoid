test-credentials.txt

# Python spike (superseded by DECISIONS.md D3; fixtures port to evals/)
__pycache__/
*.py[cod]
.venv/
venv/

# Eval runs — regenerate with `npm run eval`. Headline numbers that matter as a
# baseline go in docs/DECISIONS.md, not here.
evals/results/

# Uploaded documents. Never committed — these are an organization's statutes and
# previous applications (pii-and-donor-data).
.storage/

