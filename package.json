{
  "name": "grant-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered grant intelligence and application platform for Ukrainian NGOs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed:demo": "tsx scripts/seed-demo-org.ts",
    "smoke": "tsx scripts/smoke-pages.ts",
    "fixtures:check": "tsx evals/check-fixtures.ts",
    "eval": "tsx evals/run-eval.ts",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "digest": "tsx scripts/send-digests.ts",
    "nightly": "tsx scripts/nightly.ts",
    "audit:ui": "node -e \"require('fs').copyFileSync('scripts/audit-ui.mjs','public/_audit.js')\" && echo \"copied to public/_audit.js - in the browser: (await import('/_audit.js')).audit()\"",
    "preflight": "tsx scripts/preflight.ts",
    "purge:test": "tsx scripts/purge-test-data.ts",
    "eval:extraction": "tsx evals/run-extraction-eval.ts",
    "feedback": "tsx scripts/feedback-report.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.1",
    "next": "^15.1.3",
    "nodemailer": "^9.0.5",
    "ollama": "^0.5.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "unpdf": "^1.8.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20.11"
  }
}
