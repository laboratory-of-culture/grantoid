<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The weekly digest. Monday 10:00. LaunchAgent — same reasoning as
  ua.grantoid.nightly.plist.

    cp deploy/launchd/ua.grantoid.digest.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ua.grantoid.digest.plist

  Opt-in and off by default: without SMTP configured in .env the letter is
  written to .mail/ instead of sent, and it never carries an eligibility verdict
  or profile data. See docs/MAC.md §6 and app/(auth)/pryvatnist.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>ua.grantoid.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>cd /Users/andriituzhykov/grantoid &amp;&amp; /usr/local/bin/docker compose -f docker-compose.prod.yml -f docker-compose.mac.yml exec -T app npm run digest</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/andriituzhykov/Library/Logs/grantoid-digest.log</string>
  <key>StandardErrorPath</key><string>/Users/andriituzhykov/Library/Logs/grantoid-digest.log</string>
</dict>
</plist>
